# Theme
theme = X Dark

# Transparency + Blur
background-opacity = 0.60
background-blur-radius = 16

# Font
font-family = JetBrainsMono Nerd Font
font-family = PingFang TC
font-size = 14
font-thicken = true
freetype-load-flags = no-force-autohint

# Window
window-padding-x = 8
window-padding-y = 4
window-decoration = true

# Misc
cursor-style = bar
cursor-style-blink = false
copy-on-select = clipboard
mouse-hide-while-typing = true

# Cursor shader (disabled — was causing typing/cursor lag)
# custom-shader = ~/.config/ghostty/shaders/cursor_frozen.glsl
# custom-shader = ~/.config/ghostty/shaders/cursor_smear_fade.glsl
custom-shader-animation = false

# tab title 由 zsh 控制（跟著 git project）
shell-integration-features = no-title
